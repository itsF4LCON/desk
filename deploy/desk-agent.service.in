[Unit]
Description=desk agent (browser remote desktop)
After=pipewire.service
# Started by Hyprland at login (setup.sh adds the hook): it needs the session's
# Wayland/Hyprland environment, which only exists once you are logged in.

[Service]
WorkingDirectory=@REPO@/agent
ExecStart=@REPO@/agent/target/release/desk-agent serve --config @CONFIG@
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
